generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MembershipTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  STRIPE
  ALIPAY
  WECHAT
  POINTS
}

enum OrderType {
  TOPUP        // 余额充值
  MEMBERSHIP   // 会员购买
  PROMPT       // 提示词购买
  IMAGE        // 图片购买
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  avatar        String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  prompts        Prompt[]
  images         Image[]
  orders         Order[]
  transactions   Transaction[]
  membership     Membership?
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  description String?  @db.Text
  category    String?
  tags        String[]
  isPublic    Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  useCount    Int      @default(0)
  price       Float    @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images      Image[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompts")
}

model Image {
  id          String   @id @default(cuid())
  url         String
  filename    String?
  size        Int?
  width       Int?
  height      Int?
  mimeType    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId    String?
  prompt      Prompt?  @relation(fields: [promptId], references: [id], onDelete: SetNull)
  review      Review?
  createdAt   DateTime @default(now())

  @@map("images")
}

model Membership {
  id             String         @id @default(cuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           MembershipTier @default(FREE)
  credits        Int            @default(100)
  totalCredits   Int            @default(100)
  balance        Float          @default(0)   // 余额（人民币，可提现/消费）
  expiresAt      DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  // 会员卡相关
  cardType       String?        // month | year | none
  cardExpiresAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("memberships")
}

model Order {
  id              String        @id @default(cuid())
  orderNo         String        @unique
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  type            OrderType     @default(TOPUP)
  targetId        String?
  amount          Float
  paymentMethod   PaymentMethod
  status          OrderStatus   @default(PENDING)
  paidAt          DateTime?
  metadata        Json?
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          TransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  orderId       String?
  order         Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description   String?
  createdAt     DateTime        @default(now())

  @@map("transactions")
}

enum TransactionType {
  RECHARGE      // 充值
  CONSUME        // 消费
  REFUND         // 退款
  MEMBERSHIP     // 会员购买
}

model ImageFile {
  id          String   @id @default(cuid())
  originalUrl String
  localPath   String
  filename    String
  size        Int?
  width       Int?
  height      Int?
  mimeType    String?
  imageId     String?  @unique  // Original Image record ID
  userId      String
  createdAt   DateTime @default(now())

  @@map("image_files")
}

enum ReviewStatus {
  PENDING   // 待审核
  PASSED    // 已通过
  REJECTED  // 已拒绝
}

model Review {
  id           String       @id @default(cuid())
  imageId      String
  image        Image        @relation(fields: [imageId], references: [id], onDelete: Cascade)
  reviewerId   String?      // 审核人ID（管理员）
  status       ReviewStatus @default(PENDING)
  rejectReason String?      // 拒绝原因
  reviewedAt   DateTime?    // 审核时间
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("reviews")
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  isPopup   Boolean  @default(false)  // 是否弹窗显示
  isActive  Boolean  @default(true)
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}
