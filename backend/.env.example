# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prompt_studio

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@promptstudio.com

# Bull Queue
BULL_REDIS_URL=redis://localhost:6379

# OpenAI (optional)
OPENAI_API_KEY=

# Wanx AI Image Generation (Alibaba Cloud Bailian)
# Get your API key at: https://bailian.console.aliyun.com/
# Free tier: 50 images within 90 days, then 0.2 RMB per image
WANX_API_KEY=
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
WANX_TIMEOUT=120000
WANX_RETRY_ATTEMPTS=2

# SiliconFlow AI Image Generation (Kolors by Kwai)
# Get your API key at: https://docs.siliconflow.cn/
# Kolors is a high-quality image generation model with competitive pricing
# Supported sizes: 1024x1024, 768x1344, 1344x768, 720x1440, 1440x720, 1920x720, 768x1344
# Note: SiliconFlow is preferred over Wanx when both are configured (better pricing)
SILICONFLOW_API_KEY=
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Kolors
SILICONFLOW_TIMEOUT=120000
SILICONFLOW_RETRY_ATTEMPTS=2

# ====================
# 微信支付 V3 (Native)
# Get credentials at: https://pay.weixin.qq.com/
# ====================
WECHAT_MCHID=               # 商户号
WECHAT_SERIAL_NO=           # 证书序列号
WECHAT_PRIVATE_KEY_PATH=    # 商户私钥文件路径（apiclient_key.pem）
WECHAT_APIV3_KEY=           # APIv3密钥（32位）
WECHAT_APPID=               # 微信公众号/小程序 appid

# ====================
# 支付宝电脑网站支付
# Get credentials at: https://open.alipay.com/
# ====================
ALIPAY_APPID=               # 支付宝应用 AppID
ALIPAY_PRIVATE_KEY=         # 应用私钥（RSA2）
ALIPAY_ALIPUBLIC_KEY=       # 支付宝公钥
ALIPAY_SANDBOX=true         # 使用沙箱环境（生产环境设为 false）

# ====================
# 图片持久化存储
# 选项: local | oss
# ====================
STORAGE_TYPE=local
# 阿里云 OSS（免费额度：40GB存储/月，100GB下行流量/月）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
# 本地存储
LOCAL_STORAGE_PATH=./uploads/images
LOCAL_STORAGE_BASE_URL=http://localhost:3000/uploads/images
