# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/prompt_studio

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@promptstudio.com

# Bull Queue
BULL_REDIS_URL=redis://localhost:6379

# OpenAI (optional)
OPENAI_API_KEY=

# Wanx AI Image Generation (Alibaba Cloud Bailian)
# Get your API key at: https://bailian.console.aliyun.com/
# Free tier: 50 images within 90 days, then 0.2 RMB per image
WANX_API_KEY=
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
WANX_TIMEOUT=120000
WANX_RETRY_ATTEMPTS=2
