# ============================================
# Prompt Studio - 生产环境配置
# ============================================
# 复制此文件为 .env 并填写实际值
# cp .env.production.example .env

# ============================================
# 服务基础配置
# ============================================
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# ============================================
# 数据库 (PostgreSQL)
# ============================================
# 推荐使用云数据库：阿里云RDS、腾讯云CDB、AWS RDS
DATABASE_URL=postgresql://username:password@host:5432/promptstudio

# ============================================
# Redis 缓存
# ============================================
# 推荐使用云Redis：阿里云Redis、腾讯云Redis、AWS ElastiCache
REDIS_URL=redis://username:password@host:6379

# ============================================
# JWT 认证
# ============================================
# 【重要】使用强随机密钥，推荐64位以上
# 生成方法: openssl rand -base64 64
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_64_CHARS_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# 速率限制
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# 文件上传
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# CORS (前端域名)
# ============================================
CORS_ORIGIN=https://your-domain.com

# ============================================
# 邮件服务 (可选)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@your-domain.com

# ============================================
# Bull 队列
# ============================================
BULL_REDIS_URL=redis://username:password@host:6379

# ============================================
# OpenAI API (可选)
# ============================================
OPENAI_API_KEY=

# ============================================
# SiliconFlow API (推荐用于图片生成)
# 获取密钥: https://docs.siliconflow.cn/
# ============================================
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Kolors
SILICONFLOW_TIMEOUT=120000
SILICONFLOW_RETRY_ATTEMPTS=2

# ============================================
# 通义万相 Wanx API (备选)
# 获取密钥: https://bailian.console.aliyun.com/
# ============================================
WANX_API_KEY=
WANX_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
WANX_TIMEOUT=120000
WANX_RETRY_ATTEMPTS=2

# ============================================
# 微信支付 V3 (Native)
# 获取凭证: https://pay.weixin.qq.com/
# ============================================
WECHAT_MCHID=your_merchant_id
WECHAT_SERIAL_NO=your_certificate_serial_number
# 商户私钥文件路径（apiclient_key.pem），需要挂载到容器内
WECHAT_PRIVATE_KEY_PATH=/app/config/apiclient_key.pem
WECHAT_APIV3_KEY=your_api_v3_key_32_chars
WECHAT_APPID=your_wechat_appid

# ============================================
# 支付宝电脑网站支付
# 获取凭证: https://open.alipay.com/
# ============================================
ALIPAY_APPID=your_alipay_appid
# 应用私钥（RSA2），支持多行格式
ALIPAY_PRIVATE_KEY=your_alipay_private_key
# 支付宝公钥
ALIPAY_ALIPUBLIC_KEY=your_alipay_public_key
# 生产环境设为 false
ALIPAY_SANDBOX=false

# ============================================
# 图片存储
# 选项: local | oss
# ============================================
STORAGE_TYPE=local

# 阿里云 OSS (免费额度: 40GB存储/月, 100GB下行流量/月)
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=your_oss_bucket
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=

# 本地存储
LOCAL_STORAGE_PATH=/app/uploads/images
# 注意：生产环境应配置CDN或Nginx代理
LOCAL_STORAGE_BASE_URL=https://your-domain.com/uploads/images
